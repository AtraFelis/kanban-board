{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "칸반보드",
  "version": "0.1.0",
  "identifier": "com.kanbanboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "칸반보드",
        "width": 960,
        "height": 820,
        "minWidth": 360,
        "minHeight": 780,
        "visible": false
      },
      {
        "label": "widget",
        "title": "칸반보드 위젯",
        "url": "index.html?view=widget",
        "width": 560,
        "height": 460,
        "minWidth": 320,
        "minHeight": 260,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "AtraFelis",
    "copyright": "© 2026 AtraFelis",
    "category": "Productivity",
    "shortDescription": "개인용 칸반보드 위젯",
    "longDescription": "Windows 상시 실행 개인용 칸반보드. 바탕화면 위젯 모드와 풀보드 모드로 같은 데이터를 본다. 로컬 저장 전용.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
